{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ProductManagement.Controllers.ProductsController": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=ProductManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Attachments": {
    "AllowedExtensions": "jpg;jpeg;png",
    "MaxSizeInMegaBytes": 1,
    "EnableCompression": true
  },
  "Jwt": {
    "Issuer": "https://localhost",
    "Audience": "https://localhost:4000",
    "Lifetime": 30,
    "SigningKey": "YOUR_JWT_SIGNING_KEY"
  }
}